# ── Required in production ────────────────────────────────────────────────────
# Postgres connection string. On Vercel: Storage → Create → Neon (Postgres); it sets this for you.
# Use the *pooled* connection string. Leave unset locally to use the embedded database (.data/).
DATABASE_URL=

# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Protects /api/cron/cleanup (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Wallet: "off" disables play-money top-ups. Amounts are in paise (₹1 = 100).
WALLET_TEST_MODE=on
WALLET_SIGNUP_BONUS_PAISE=100000
WALLET_MAX_TRANSFER_PAISE=10000000

# Download links on the website. Defaults: /downloads/vartalap.apk if that file exists.
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_IOS_URL=

# Extra origins allowed to call the API (comma separated), e.g. a custom domain during migration.
ALLOWED_ORIGINS=

# Multiply all rate limits (production only), e.g. 2 for a busy beta.
RATE_LIMIT_FACTOR=1
# Max connections per serverless instance (keep small; use a pooled DATABASE_URL).
DATABASE_POOL_MAX=5
