# ── Required in production ────────────────────────────────────────────────────
# Postgres connection string. On Vercel: Storage → Create → Neon (Postgres); it sets this for you.
# Use the *pooled* connection string. Leave unset locally to use the embedded database (.data/).
DATABASE_URL=

# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Protects /api/cron/cleanup (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Wallet: "off" disables play-money top-ups. Amounts are in paise (₹1 = 100).
WALLET_TEST_MODE=on
WALLET_SIGNUP_BONUS_PAISE=100000
WALLET_MAX_TRANSFER_PAISE=10000000

# Download links on the website. Defaults: /downloads/vartalap.apk if that file exists.
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_IOS_URL=

# Extra origins allowed to call the API (comma separated), e.g. a custom domain during migration.
ALLOWED_ORIGINS=

# Multiply all rate limits (production only), e.g. 2 for a busy beta.
RATE_LIMIT_FACTOR=1
# Max connections per serverless instance (keep small; use a pooled DATABASE_URL).
DATABASE_POOL_MAX=5

# ── Calls (in-app voice/video) ────────────────────────────────────────────────
# STUN is built in. Add a TURN server so calls connect behind strict/corporate/mobile NATs
# (e.g. Cloudflare Calls TURN, Twilio Network Traversal, Metered, or your own coturn).
TURN_URL=            # comma separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Business telephony ────────────────────────────────────────────────────────
# Public URL carriers call back. Required for Twilio signature checks behind Vercel.
PUBLIC_BASE_URL=     # e.g. https://your-app.vercel.app

# Twilio (voice + SMS + WhatsApp, worldwide)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Exotel (India: ExoPhones, click-to-call, SMS)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com   # api.in.exotel.com for the Mumbai cluster
EXOTEL_SMS_SENDER=                # DLT-approved sender ID
EXOTEL_DLT_ENTITY_ID=
EXOTEL_WEBHOOK_KEY=               # random string; add ?key=… to the Passthru URL

# ── Social publishing ─────────────────────────────────────────────────────────
# Optional webhook (Zapier / Make / n8n / Buffer) that publishes posts for you.
# Receives POST {event:"social.publish", postId, text, link, platforms, accounts}.
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_SECRET=            # sent as the x-vartalap-secret header
